# Windows 中文路徑更穩定的影像讀寫方式
def imread_unicode(path: str):
    if not os.path.isfile(path):
        return None
    try:
        data = np.fromfile(path, dtype=np.uint8)
        if data.size == 0:
            return None
        return cv2.imdecode(data, cv2.IMREAD_COLOR)
    except Exception:
        return None

def imwrite_unicode(path: str, image) -> bool:
    try:
        ext = os.path.splitext(path)[1]
        success, encoded = cv2.imencode(ext, image)
        if not success:
            return False
        encoded.tofile(path)
        return True
    except Exception:
        return False

def enhance_hand_region(image_bgr: np.ndarray, bbox: Optional[tuple[int, int, int, int]] = None) -> np.ndarray:
    """針對手部區域做額外增強（對比度提升 + 銳化）。"""
    if bbox is None:
        return image_bgr
    try:
        x1, y1, x2, y2 = bbox
        h, w = image_bgr.shape[:2]
        x1 = max(0, min(w - 1, x1)); x2 = max(0, min(w, x2))
        y1 = max(0, min(h - 1, y1)); y2 = max(0, min(h, y2))
        if x2 <= x1 or y2 <= y1:
            return image_bgr
        
        # 提取手部區域
        hand_roi = image_bgr[y1:y2, x1:x2].copy()
        
        # CLAHE 增強對比度
        lab = cv2.cvtColor(hand_roi, cv2.COLOR_BGR2LAB)
        l, a, b = cv2.split(lab)
        clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(4, 4))
        cl = clahe.apply(l)
        lab = cv2.merge((cl, a, b))
        hand_roi = cv2.cvtColor(lab, cv2.COLOR_LAB2BGR)
        
        # 銳化
        kernel = np.array([[-1, -1, -1], [-1, 9, -1], [-1, -1, -1]]) * 1.2
        hand_roi = cv2.filter2D(hand_roi, -1, kernel)
        hand_roi = np.clip(hand_roi, 0, 255).astype(np.uint8)
        
        # 貼回原圖
        result = image_bgr.copy()
        result[y1:y2, x1:x2] = hand_roi
        return result
    except Exception:
        return image_bgr

def preprocess_for_pose(image: np.ndarray,
                        enable_clahe: bool = True,
                        target_long_side: int = 1280) -> np.ndarray:
    """提升精度的前處理（強化手部與整體姿態）：
    - 可選 CLAHE 提升局部對比（對昏暗或低對比影像有幫助）
    - 將長邊縮放到較高解析度（預設 1280，提升手部細節）
    """
    img = image
    if enable_clahe:
        try:
            lab = cv2.cvtColor(img, cv2.COLOR_BGR2LAB)
            l, a, b = cv2.split(lab)
            clahe = cv2.createCLAHE(clipLimit=2.5, tileGridSize=(8, 8))
            cl = clahe.apply(l)
            lab = cv2.merge((cl, a, b))
            img = cv2.cvtColor(lab, cv2.COLOR_LAB2BGR)
        except Exception:
            img = image

    try:
        h, w = img.shape[:2]
        long_side = max(h, w)
        if target_long_side and target_long_side > 0 and long_side < target_long_side:
            scale = target_long_side / float(long_side)
            new_w = int(round(w * scale))
            new_h = int(round(h * scale))
            img = cv2.resize(img, (new_w, new_h), interpolation=cv2.INTER_CUBIC)
    except Exception:
        pass
    return img

def to_cv2_uint8_bgr(image) -> Optional[np.ndarray]:
    """將 detector 輸出統一轉為 OpenCV 可編碼的 uint8 BGR 影像。
    支援: numpy RGB/BGR/灰階、PIL.Image。其餘回傳 None。
    """
    if image is None:
        return None

    # PIL -> numpy
    if _PILImage is not None and isinstance(image, _PILImage.Image):
        # 轉成 RGB 再到 numpy
        rgb = image.convert("RGB")
        np_rgb = np.array(rgb)
        # RGB -> BGR
        return cv2.cvtColor(np_rgb, cv2.COLOR_RGB2BGR)

    # numpy array
    if isinstance(image, np.ndarray):
        arr = image
        # 若不是 uint8，嘗試轉為 uint8（常見是 float [0,1]）
        if arr.dtype != np.uint8:
            arr = np.clip(arr, 0, 255)
            if arr.max() <= 1.0:
                arr = (arr * 255.0).astype(np.uint8)
            else:
                arr = arr.astype(np.uint8)

        # shape 判斷: 灰階 (H,W) / 彩色 (H,W,3)
        if arr.ndim == 2:
            return arr  # 灰階可直接編碼
        if arr.ndim == 3 and arr.shape[2] == 3:
            # 無法直接判斷是 RGB 還是 BGR；多數模型回傳 RGB，嘗試轉 BGR
            # 這裡假設為 RGB
            return cv2.cvtColor(arr, cv2.COLOR_RGB2BGR)
        return None

    return None

def _init_yolo_model():
    global _yolo_person_model
    if YOLO is None:
        return None
    if _yolo_person_model is None:
        try:
            # 使用 yolov8s，對困難姿勢更穩；首次執行會自動下載
            _yolo_person_model = YOLO("yolov8s.pt")
        except Exception:
            _yolo_person_model = None
    return _yolo_person_model

def deblur_sharpen(image_bgr: np.ndarray, strength: float = 1.5) -> np.ndarray:
    """輕量去模糊銳化：對動態模糊有幫助。"""
    try:
        kernel = np.array([[-1, -1, -1], [-1, 9, -1], [-1, -1, -1]]) * strength
        sharpened = cv2.filter2D(image_bgr, -1, kernel)
        return np.clip(sharpened, 0, 255).astype(np.uint8)
    except Exception:
        return image_bgr

def detect_person_bbox(image_bgr: np.ndarray) -> Optional[tuple[int, int, int, int]]:
    """以 YOLOv8 偵測單人 bbox（多尺度嘗試），回傳 (x1,y1,x2,y2)。失敗回 None。"""
    model = _init_yolo_model()
    if model is None:
        return None
    # 多尺度嘗試：1280 -> 960 -> 640，conf 逐步降低（對側面/模糊更穩）
    scales = [(1280, 0.2), (960, 0.15), (640, 0.1)]
    for imgsz, conf_thresh in scales:
        try:
            results = model.predict(source=image_bgr, imgsz=imgsz, conf=conf_thresh, classes=[0], verbose=False)
            if not results or len(results) == 0:
                continue
            boxes = getattr(results[0], 'boxes', None)
            if boxes is None or boxes.xyxy is None or len(boxes.xyxy) == 0:
                continue
            xyxy = boxes.xyxy.cpu().numpy()
            h, w = image_bgr.shape[:2]
            best = None
            best_area = -1.0
            for b in xyxy:
                x1, y1, x2, y2 = [int(round(v)) for v in b[:4]]
                x1 = max(0, min(w - 1, x1)); x2 = max(0, min(w - 1, x2))
                y1 = max(0, min(h - 1, y1)); y2 = max(0, min(h - 1, y2))
                if x2 <= x1 or y2 <= y1:
                    continue
                area = (x2 - x1) * (y2 - y1)
                if area > best_area:
                    best_area = area
                    best = (x1, y1, x2, y2)
            if best is not None:
                if DEBUG_VERBOSE:
                    print(f"[YOLO-MULTI] imgsz={imgsz} conf={conf_thresh} bbox={best} area={best_area}")
                return best
        except Exception:
            continue
    return None

def expand_crop(image_bgr: np.ndarray, bbox: tuple[int, int, int, int],
                expand_ratio: float = 1.3,
                target_long_side: int = 1280) -> tuple[np.ndarray, tuple[int, int, int, int]]:
    """對 bbox 做擴張裁切並放大。回傳 (crop_bgr, placed_bbox_in_original).
    placed_bbox 為裁切後在原圖上的座標（擴張後的矩形）。"""
    x1, y1, x2, y2 = bbox
    h, w = image_bgr.shape[:2]
    cx = (x1 + x2) / 2.0
    cy = (y1 + y2) / 2.0
    bw = (x2 - x1)
    bh = (y2 - y1)
    bw2 = bw * expand_ratio
    bh2 = bh * expand_ratio
    nx1 = int(round(cx - bw2 / 2.0))
    ny1 = int(round(cy - bh2 / 2.0))
    nx2 = int(round(cx + bw2 / 2.0))
    ny2 = int(round(cy + bh2 / 2.0))
    nx1 = max(0, nx1); ny1 = max(0, ny1)
    nx2 = min(w, nx2); ny2 = min(h, ny2)
    if nx2 - nx1 <= 2 or ny2 - ny1 <= 2:
        return image_bgr, (0, 0, w, h)
    crop = image_bgr[ny1:ny2, nx1:nx2]
    ch, cw = crop.shape[:2]
    long_side = max(ch, cw)
    if long_side < target_long_side:
        scale = target_long_side / float(long_side)
        new_w = int(round(cw * scale))
        new_h = int(round(ch * scale))
        crop = cv2.resize(crop, (new_w, new_h), interpolation=cv2.INTER_CUBIC)
    return crop, (nx1, ny1, nx2, ny2)

def paste_pose(canvas_bgr: np.ndarray, pose_crop_bgr: np.ndarray, bbox: tuple[int, int, int, int],
               mask_thresh: int = 10) -> np.ndarray:
    """將裁切後的骨架圖貼回全圖黑底畫布。"""
    x1, y1, x2, y2 = bbox
    box_w = x2 - x1
    box_h = y2 - y1
    if box_w <= 0 or box_h <= 0:
        return canvas_bgr
    ph, pw = pose_crop_bgr.shape[:2]
    # 將骨架圖縮回 bbox 尺寸
    pose_resized = cv2.resize(pose_crop_bgr, (box_w, box_h), interpolation=cv2.INTER_AREA)
    gray = cv2.cvtColor(pose_resized, cv2.COLOR_BGR2GRAY)
    mask = gray > mask_thresh
    roi = canvas_bgr[y1:y2, x1:x2]
    roi[mask] = pose_resized[mask]
    canvas_bgr[y1:y2, x1:x2] = roi
    return canvas_bgr

def clean_pose_lines(pose_bgr: np.ndarray, thresh: int = 10) -> np.ndarray:
    """輕量清理：去除微弱殘點、確保線條銳利。"""
    if not POST_CLEAN:
        return pose_bgr
    try:
        gray = cv2.cvtColor(pose_bgr, cv2.COLOR_BGR2GRAY)
        mask = (gray > max(0, int(thresh))).astype(np.uint8) * 255
        kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (3, 3))
        opened = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel, iterations=1)
        # 只保留開運算後的線條位置顏色
        out = np.zeros_like(pose_bgr)
        idx = opened > 0
        out[idx] = pose_bgr[idx]
        return out
    except Exception:
        return pose_bgr

def _ensure_bbox(x1: int, y1: int, x2: int, y2: int, w: int, h: int) -> Optional[tuple[int, int, int, int]]:
    x1 = max(0, min(w - 1, x1)); x2 = max(0, min(w, x2))
    y1 = max(0, min(h - 1, y1)); y2 = max(0, min(h, y2))
    if x2 - x1 < 2 or y2 - y1 < 2:
        return None
    return (x1, y1, x2, y2)

def _expand_bbox(bbox: tuple[int, int, int, int], w: int, h: int, ratio: float) -> tuple[int, int, int, int]:
    x1, y1, x2, y2 = bbox
    cx = (x1 + x2) / 2.0
    cy = (y1 + y2) / 2.0
    bw = (x2 - x1) * ratio
    bh = (y2 - y1) * ratio
    nx1 = int(round(cx - bw / 2.0))
    ny1 = int(round(cy - bh / 2.0))
    nx2 = int(round(cx + bw / 2.0))
    ny2 = int(round(cy + bh / 2.0))
    return _ensure_bbox(nx1, ny1, nx2, ny2, w, h) or (0, 0, w, h)

def _warp_bbox_with_flow(prev_bgr: np.ndarray, curr_bgr: np.ndarray, bbox: tuple[int, int, int, int]) -> Optional[tuple[int, int, int, int]]:
    try:
        x1, y1, x2, y2 = bbox
        prev_gray = cv2.cvtColor(prev_bgr, cv2.COLOR_BGR2GRAY)
        curr_gray = cv2.cvtColor(curr_bgr, cv2.COLOR_BGR2GRAY)
        flow = cv2.calcOpticalFlowFarneback(prev_gray, curr_gray, None, 0.5, 3, 15, 3, 5, 1.2, 0)
        sub = flow[y1:y2, x1:x2]
        dx = float(np.median(sub[..., 0]))
        dy = float(np.median(sub[..., 1]))
        w = curr_bgr.shape[1]; h = curr_bgr.shape[0]
        return _ensure_bbox(int(round(x1 + dx)), int(round(y1 + dy)), int(round(x2 + dx)), int(round(y2 + dy)), w, h)
    except Exception:
        return None

def _init_or_update_tracker(frame_bgr: np.ndarray, bbox: Optional[tuple[int, int, int, int]], reset: bool = False) -> Optional[tuple[int, int, int, int]]:
    global _cv_tracker
    if reset:
        _cv_tracker = None
    try:
        if _cv_tracker is None and hasattr(cv2, 'TrackerCSRT_create') and bbox is not None:
            _cv_tracker = cv2.TrackerCSRT_create()
            _cv_tracker.init(frame_bgr, (bbox[0], bbox[1], bbox[2]-bbox[0], bbox[3]-bbox[1]))
            return bbox
        if _cv_tracker is not None:
            ok, rect = _cv_tracker.update(frame_bgr)
            if ok and rect is not None:
                x, y, w, h = rect
                W = frame_bgr.shape[1]; H = frame_bgr.shape[0]
                return _ensure_bbox(int(round(x)), int(round(y)), int(round(x+w)), int(round(y+h)), W, H)
    except Exception:
        _cv_tracker = None
    return None

def _pose_nonzero_ratio(pose_bgr: np.ndarray, thresh: int = 10) -> float:
    gray = cv2.cvtColor(pose_bgr, cv2.COLOR_BGR2GRAY)
    mask = gray > max(0, int(thresh))
    return float(mask.mean())

def infer_pose_from_temporal(prev_pose_bgr: Optional[np.ndarray],
                            prev2_pose_bgr: Optional[np.ndarray],
                            prev_frame_bgr: Optional[np.ndarray],
                            prev2_frame_bgr: Optional[np.ndarray],
                            curr_frame_bgr: np.ndarray) -> Optional[np.ndarray]:
    """使用前後幀的骨架進行推論（光流對齊 + 插值）。"""
    if prev_pose_bgr is None and prev2_pose_bgr is None:
        return None
    if prev_frame_bgr is None and prev2_frame_bgr is None:
        return None
    
    try:
        h, w = curr_frame_bgr.shape[:2]
        inferred = np.zeros((h, w, 3), dtype=np.uint8)
        
        # 優先使用前一幀
        if prev_pose_bgr is not None and prev_frame_bgr is not None:
            try:
                prev_gray = cv2.cvtColor(prev_frame_bgr, cv2.COLOR_BGR2GRAY)
                curr_gray = cv2.cvtColor(curr_frame_bgr, cv2.COLOR_BGR2GRAY)
                flow = cv2.calcOpticalFlowFarneback(prev_gray, curr_gray, None, 0.5, 3, 15, 3, 5, 1.2, 0)
                
                # 將前一幀骨架對齊到當前幀
                grid_x, grid_y = np.meshgrid(np.arange(w, dtype=np.float32), np.arange(h, dtype=np.float32))
                map_x = grid_x + flow[..., 0].astype(np.float32)
                map_y = grid_y + flow[..., 1].astype(np.float32)
                warped_prev = cv2.remap(prev_pose_bgr, map_x, map_y, cv2.INTER_LINEAR,
                                        borderMode=cv2.BORDER_CONSTANT, borderValue=0)
                inferred = warped_prev
            except Exception:
                pass
        
        # 如果有更前一幀，進行插值（簡單平均）
        if prev2_pose_bgr is not None and prev2_frame_bgr is not None:
            try:
                prev2_gray = cv2.cvtColor(prev2_frame_bgr, cv2.COLOR_BGR2GRAY)
                curr_gray = cv2.cvtColor(curr_frame_bgr, cv2.COLOR_BGR2GRAY)
                flow2 = cv2.calcOpticalFlowFarneback(prev2_gray, curr_gray, None, 0.5, 3, 15, 3, 5, 1.2, 0)
                
                grid_x, grid_y = np.meshgrid(np.arange(w, dtype=np.float32), np.arange(h, dtype=np.float32))
                map_x2 = grid_x + flow2[..., 0].astype(np.float32)
                map_y2 = grid_y + flow2[..., 1].astype(np.float32)
                warped_prev2 = cv2.remap(prev2_pose_bgr, map_x2, map_y2, cv2.INTER_LINEAR,
                                         borderMode=cv2.BORDER_CONSTANT, borderValue=0)
                
                # 插值：前一幀權重 0.6，更前一幀權重 0.4
                if prev_pose_bgr is not None:
                    inferred = cv2.addWeighted(inferred, 0.6, warped_prev2, 0.4, 0.0)
                else:
                    inferred = warped_prev2
            except Exception:
                pass
        
        return inferred
    except Exception:
        return None

def _hist_corr(prev_bgr: np.ndarray, curr_bgr: np.ndarray) -> float:
    """計算 HSV 直方圖相關係數（0~1），用於粗略硬切偵測。"""
    try:
        prev_hsv = cv2.cvtColor(prev_bgr, cv2.COLOR_BGR2HSV)
        curr_hsv = cv2.cvtColor(curr_bgr, cv2.COLOR_BGR2HSV)
        hist_prev = cv2.calcHist([prev_hsv], [0, 1], None, [32, 32], [0, 180, 0, 256])
        hist_curr = cv2.calcHist([curr_hsv], [0, 1], None, [32, 32], [0, 180, 0, 256])
        cv2.normalize(hist_prev, hist_prev)
        cv2.normalize(hist_curr, hist_curr)
        corr = cv2.compareHist(hist_prev, hist_curr, cv2.HISTCMP_CORREL)
        return float(max(0.0, min(1.0, corr)))
    except Exception:
        return 1.0

def temporal_stabilize_with_optical_flow(prev_frame_bgr: Optional[np.ndarray],
                                         prev_pose_bgr: Optional[np.ndarray],
                                         curr_frame_bgr: np.ndarray,
                                         curr_pose_bgr: np.ndarray,
                                         max_prev_weight: Optional[float] = None,
                                         flow_mag_thresh: Optional[float] = None,
                                         cut_mag_thresh: Optional[float] = None,
                                         cut_hist_corr_thresh: Optional[float] = None,
                                         mask_thresh: Optional[int] = None,
                                         prev_fill_weight: Optional[float] = None) -> tuple[np.ndarray, np.ndarray, np.ndarray, bool]:
    """使用稠密光流將上一幀骨架對齊到當前影格，並自適應混合降低抖動。
    - max_prev_weight: 過去畫面最大混合權重（0~1），避免殘影過重
    - flow_mag_thresh: 當平均位移大於此閾值時，減少歷史權重
    回傳: (stabilized_pose, new_prev_frame, new_prev_pose)
    """
    if prev_frame_bgr is None or prev_pose_bgr is None:
        return curr_pose_bgr, curr_frame_bgr, curr_pose_bgr, False

    try:
        # 先做快速硬切偵測（顏色分佈變化過大）
        hist_corr = _hist_corr(prev_frame_bgr, curr_frame_bgr)
        # 自動調參將在計算光流後一併決定門檻

        prev_gray = cv2.cvtColor(prev_frame_bgr, cv2.COLOR_BGR2GRAY)
        curr_gray = cv2.cvtColor(curr_frame_bgr, cv2.COLOR_BGR2GRAY)

        flow = cv2.calcOpticalFlowFarneback(prev_gray, curr_gray, None,
                                            0.5, 3, 15, 3, 5, 1.2, 0)
        h, w = curr_gray.shape[:2]
        grid_x, grid_y = np.meshgrid(np.arange(w, dtype=np.float32),
                                      np.arange(h, dtype=np.float32))
        map_x = grid_x + flow[..., 0].astype(np.float32)
        map_y = grid_y + flow[..., 1].astype(np.float32)
        warped_prev_pose = cv2.remap(prev_pose_bgr, map_x, map_y, cv2.INTER_LINEAR,
                                     borderMode=cv2.BORDER_CONSTANT, borderValue=0)

        mag = np.linalg.norm(flow, axis=2).mean()

        # ===== 自動調參（指數滑動）=====
        global _adaptive_ema_flow, _adaptive_ema_hist
        alpha = 0.2
        if _adaptive_ema_flow is None:
            _adaptive_ema_flow = float(mag)
        else:
            _adaptive_ema_flow = (1 - alpha) * _adaptive_ema_flow + alpha * float(mag)
        if _adaptive_ema_hist is None:
            _adaptive_ema_hist = float(hist_corr)
        else:
            _adaptive_ema_hist = (1 - alpha) * _adaptive_ema_hist + alpha * float(hist_corr)

        # 自動門檻（依序列難度自適應）
        auto_flow_mag_thresh = max(6.0, min(18.0, 2.2 * _adaptive_ema_flow))
        auto_cut_mag_thresh = max(15.0, min(40.0, 2.8 * auto_flow_mag_thresh))
        auto_cut_hist_corr_thresh = 0.2 if _adaptive_ema_flow < 10.0 else 0.25
        auto_max_prev_weight = 0.5 - min(0.25, max(0.0, (_adaptive_ema_flow - 2.0) / (18.0 - 2.0) * 0.25))
        auto_mask_thresh = 16 if _adaptive_ema_flow < 6.0 else (24 if _adaptive_ema_flow < 12.0 else 32)
        auto_prev_fill_weight = 0.35 if _adaptive_ema_flow < 8.0 else (0.25 if _adaptive_ema_flow < 12.0 else 0.15)

        # 若外部未指定，採自動值
        flow_mag_thresh = float(auto_flow_mag_thresh) if flow_mag_thresh is None else flow_mag_thresh
        cut_mag_thresh = float(auto_cut_mag_thresh) if cut_mag_thresh is None else cut_mag_thresh
        cut_hist_corr_thresh = float(auto_cut_hist_corr_thresh) if cut_hist_corr_thresh is None else cut_hist_corr_thresh
        max_prev_weight = float(auto_max_prev_weight) if max_prev_weight is None else max_prev_weight
        mask_thresh = int(auto_mask_thresh) if mask_thresh is None else mask_thresh
        prev_fill_weight = float(auto_prev_fill_weight) if prev_fill_weight is None else prev_fill_weight

        # 硬切判定（應用自動閾值）
        if hist_corr < cut_hist_corr_thresh:
            return curr_pose_bgr, curr_frame_bgr, curr_pose_bgr, True
        if mag >= cut_mag_thresh:
            return curr_pose_bgr, curr_frame_bgr, curr_pose_bgr, True

        # 合成策略：
        # 1) 優先保留「當前」骨架像素，避免殘影。
        # 2) 當前為黑背景處，用少量歷史（對齊後）填補，降低抖動斷裂。
        prev_w = max(0.0, min(max_prev_weight, 1.0 - (mag / max(flow_mag_thresh, 1e-6))))
        prev_w = float(prev_w)
        curr_w = 1.0 - prev_w

        # 當前骨架像素遮罩（非黑）：
        # 使用亮度閾值辨識線條像素（OpenPose 圖通常是彩色在黑底）
        gray_curr = cv2.cvtColor(curr_pose_bgr, cv2.COLOR_BGR2GRAY)
        mask_curr = (gray_curr > max(0, int(mask_thresh)))

        # 基底先用歷史小權重混合（作為背景填補）
        base = cv2.addWeighted(curr_pose_bgr, curr_w, warped_prev_pose, prev_w, 0.0)

        # 將當前線條位置強制蓋回去（避免殘影）
        if mask_curr.any():
            stabilized = base.copy()
            stabilized[mask_curr] = curr_pose_bgr[mask_curr]
        else:
            stabilized = base

        # 在非線條區域可再用更小的歷史填補（可選，這裡用 prev_fill_weight）
        if 0.0 < prev_fill_weight < prev_w:
            not_line = ~mask_curr
            if not_line.any():
                blended_bg = cv2.addWeighted(curr_pose_bgr, 1.0 - prev_fill_weight,
                                             warped_prev_pose, prev_fill_weight, 0.0)
                stabilized[not_line] = blended_bg[not_line]
        return stabilized, curr_frame_bgr, stabilized, False
    except Exception:
        # 光流失敗則直接回傳當前
        return curr_pose_bgr, curr_frame_bgr, curr_pose_bgr, False

prev_frame_bgr = None
prev_pose_bgr = None
prev2_frame_bgr = None  # 更前一幀的影像（用於推論）
prev2_pose_bgr = None    # 更前一幀的骨架（用於推論）
_adaptive_ema_flow = None  # 指數滑動平均：光流平均位移
_adaptive_ema_hist = None  # 指數滑動平均：色彩直方圖相關

for filename in file_list:
    input_path = os.path.join(input_folder, filename)
    output_path = os.path.join(output_folder, filename)

    # 檢查是否為圖片
    if filename.lower().endswith(('.png', '.jpg', '.jpeg', '.webp')):
        try:
            # 先檢查檔案是否存在且為檔案
            if not os.path.isfile(input_path):
                print(f"跳過（不存在或非檔案）: {input_path}")
                continue

            # 使用對中文路徑友善的讀法
            img = imread_unicode(input_path)
            if img is None:
                print(f"讀取失敗（可能是路徑/檔名或檔案損壞）: {input_path}")
                continue
            
            # 前處理：提升對比並上採樣後再偵測（強化手部與整體姿態）
            pre_img = preprocess_for_pose(img, enable_clahe=True, target_long_side=1280)
            # 去模糊銳化：對動態模糊有幫助
            pre_img = deblur_sharpen(pre_img, strength=1.5)

            # 強韌的人物 ROI 選擇：YOLO -> CSRT 追蹤 -> 光流 -> 全圖（對側面/模糊更穩）
            yolo_bbox = detect_person_bbox(pre_img)
            if yolo_bbox is not None:
                _prev_bbox = _init_or_update_tracker(pre_img, yolo_bbox, reset=True)
                candidate_bbox = yolo_bbox
                if DEBUG_VERBOSE:
                    print(f"[ROI] source=YOLO bbox={candidate_bbox}")
            else:
                # YOLO 失敗時，更積極使用追蹤/光流（對側面/模糊場景很重要）
                tracked = _init_or_update_tracker(pre_img, None, reset=False)
                if tracked is not None:
                    candidate_bbox = tracked
                    if DEBUG_VERBOSE:
                        print(f"[ROI] source=CSRT bbox={candidate_bbox}")
                elif _prev_bbox is not None and prev_frame_bgr is not None:
                    # 光流映射：即使追蹤失敗，也嘗試用光流預測位置
                    warped = _warp_bbox_with_flow(prev_frame_bgr, pre_img, _prev_bbox)
                    candidate_bbox = warped if warped is not None else None
                    if DEBUG_VERBOSE and candidate_bbox is not None:
                        print(f"[ROI] source=FLOW bbox={candidate_bbox}")
                else:
                    candidate_bbox = None

            # 若所有方法都失敗，使用全圖（確保不漏檢）
            if candidate_bbox is None:
                candidate_bbox = (0, 0, pre_img.shape[1], pre_img.shape[0])
                if DEBUG_VERBOSE:
                    print(f"[ROI] source=FULL_IMAGE bbox={candidate_bbox}")

            w0, h0 = pre_img.shape[1], pre_img.shape[0]
            candidate_bbox = _expand_bbox(candidate_bbox, w0, h0, ratio=1.3)
            # 提高偵測解析度以強化手部與整體姿態（從 1280 提升到 1536）
            crop_img, placed_bbox = expand_crop(pre_img, candidate_bbox, expand_ratio=1.0, target_long_side=1536)
            if DEBUG_VERBOSE:
                print(f"[ROI] placed_bbox={placed_bbox}")

            # 針對手部區域做額外增強（假設手部在人物上半身）
            h_roi = crop_img.shape[0]
            w_roi = crop_img.shape[1]
            # 手部通常在人物上半身，假設在 bbox 的上 60% 區域
            hand_bbox = (int(w_roi * 0.2), int(h_roi * 0.1), int(w_roi * 0.8), int(h_roi * 0.6))
            crop_img = enhance_hand_region(crop_img, hand_bbox)

            # 執行 DWPose 偵測（強制啟用手部和臉部偵測，強化手部動作與整體姿態）
            try:
                processed_img = detector(crop_img, detect_hand=True, detect_face=True)
            except Exception:
                # 若版本不支援參數，嘗試不帶參數
                try:
                    processed_img = detector(crop_img)
                except Exception:
                    print(f"警告：DWPose 偵測失敗，跳過: {filename}")
                    continue

            # 將輸出轉為 OpenCV 可寫入格式
            processed_cv = to_cv2_uint8_bgr(processed_img)
            if processed_cv is None:
                print(f"偵測輸出無法轉換為可寫入影像，跳過: {filename}")
                continue
            
            # 將骨架圖貼回全尺寸黑底畫布
            canvas = np.zeros_like(pre_img)
            composed = paste_pose(canvas, processed_cv, placed_bbox, mask_thresh=10)
            composed = clean_pose_lines(composed, thresh=10)

            # 檢測骨架是否為空或太少
            density = _pose_nonzero_ratio(composed, thresh=10)
            
            # 如果骨架為空，使用前後幀進行推論
            if density < 0.0008:
                inferred_pose = infer_pose_from_temporal(
                    prev_pose_bgr, prev2_pose_bgr,
                    prev_frame_bgr, prev2_frame_bgr,
                    pre_img
                )
                if inferred_pose is not None:
                    inferred_density = _pose_nonzero_ratio(inferred_pose, thresh=10)
                    if inferred_density >= 0.0008:
                        composed = inferred_pose
                        if DEBUG_VERBOSE:
                            print(f"[INFER] 使用前後幀推論骨架，密度={inferred_density:.6f}")
            
            # 若骨架像素太少，啟動強化重試：更大 ROI -> 全圖（強化手部與整體姿態）
            density = _pose_nonzero_ratio(composed, thresh=10)
            if density < 0.0008:
                bigger_bbox = _expand_bbox(candidate_bbox, w0, h0, ratio=1.6)
                # 提高解析度到 1920 以強化手部細節
                crop2, placed2 = expand_crop(pre_img, bigger_bbox, expand_ratio=1.0, target_long_side=1920)
                # 針對手部區域做額外增強
                h2_roi = crop2.shape[0]
                w2_roi = crop2.shape[1]
                hand2_bbox = (int(w2_roi * 0.2), int(h2_roi * 0.1), int(w2_roi * 0.8), int(h2_roi * 0.6))
                crop2 = enhance_hand_region(crop2, hand2_bbox)
                try:
                    processed2 = detector(crop2, detect_hand=True, detect_face=True)
                except Exception:
                    try:
                        processed2 = detector(crop2)
                    except Exception:
                        processed2 = None
                proc2 = to_cv2_uint8_bgr(processed2)
                if proc2 is not None:
                    canvas2 = np.zeros_like(pre_img)
                    composed2 = paste_pose(canvas2, proc2, placed2, mask_thresh=10)
                    if _pose_nonzero_ratio(composed2, thresh=10) >= density:
                        composed = composed2
                        placed_bbox = placed2
                        candidate_bbox = bigger_bbox
                if _pose_nonzero_ratio(composed, thresh=10) < 0.0008:
                    # 全圖重試（強化手部與整體姿態）
                    # 針對手部區域做額外增強
                    h_full = pre_img.shape[0]
                    w_full = pre_img.shape[1]
                    hand_full_bbox = (int(w_full * 0.2), int(h_full * 0.1), int(w_full * 0.8), int(h_full * 0.6))
                    pre_img_enhanced = enhance_hand_region(pre_img, hand_full_bbox)
                    try:
                        processed3 = detector(pre_img_enhanced, detect_hand=True, detect_face=True)
                    except Exception:
                        try:
                            processed3 = detector(pre_img_enhanced)
                        except Exception:
                            processed3 = None
                    if processed3 is not None:
                        proc3 = to_cv2_uint8_bgr(processed3)
                        if proc3 is not None:
                            composed = proc3
                            placed_bbox = (0, 0, w0, h0)

            _prev_bbox = placed_bbox
            
            # 嚴格無殘影：直接用當幀；否則採用時序穩定化
            if STRICT_NO_GHOST:
                stabilized_cv = composed
                # 更新前兩幀供推論使用（但不做混合）
                prev2_frame_bgr = prev_frame_bgr
                prev2_pose_bgr = prev_pose_bgr
                prev_frame_bgr = pre_img
                prev_pose_bgr = composed
            else:
                # 時序穩定化 + 剪輯偵測（自動調參）
                # 先保存前一幀供推論使用
                prev2_frame_bgr = prev_frame_bgr
                prev2_pose_bgr = prev_pose_bgr
                stabilized_cv, prev_frame_bgr, prev_pose_bgr, is_cut = temporal_stabilize_with_optical_flow(
                    prev_frame_bgr, prev_pose_bgr, pre_img, composed,
                    max_prev_weight=None, flow_mag_thresh=None,
                    cut_mag_thresh=None, cut_hist_corr_thresh=None,
                    mask_thresh=None, prev_fill_weight=None
                )
                if is_cut:
                    print(f"偵測到剪輯或巨大位移，重置時序：{filename}")
                    # 剪輯時重置更前一幀
                    prev2_frame_bgr = None
                    prev2_pose_bgr = None

            # 儲存新的骨架圖（對中文路徑友善的寫法）
            if not imwrite_unicode(output_path, stabilized_cv):
                print(f"寫入失敗: {output_path}")
                continue
            
            print(f"已處理並儲存: {output_path}")

        except Exception as e:
            print(f"處理 {filename} 失敗: {e}")

print("--- 全部處理完畢！ ---")
